{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoopTracker",
  "version": "0.1.0",
  "identifier": "com.projekod.pooptracker",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node dist.mjs",
    "beforeBuildCommand": "node dist.mjs"
  },
  "app": {
    "windows": [{ "title": "PoopTracker", "width": 1400, "height": 900, "minWidth": 1100, "minHeight": 700 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
